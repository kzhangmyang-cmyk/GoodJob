{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/individual-demand-signal.v1.schema.json",
  "title": "IndividualDemandSignal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "publicActorKey",
    "publicDisplayName",
    "publicProfileUrl",
    "sourcePlatform",
    "evidenceIds",
    "demandCategory",
    "demandSummary",
    "locationHint",
    "buyingStage",
    "negativeSignals",
    "subjectKind",
    "status",
    "version",
    "identityResolved",
    "latestDecisionVersion",
    "approvedDecisionVersion",
    "updatedAt",
    "firstSeenAt",
    "lastSeenAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "publicActorKey": { "type": "string", "minLength": 1 },
    "publicDisplayName": { "type": "string", "minLength": 1 },
    "publicProfileUrl": { "type": "string", "format": "uri" },
    "sourcePlatform": { "type": "string", "minLength": 1 },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "demandCategory": { "type": "string", "minLength": 1 },
    "demandSummary": { "type": "string", "minLength": 1 },
    "locationHint": { "type": "string" },
    "buyingStage": {
      "enum": [
        "awareness",
        "problem_defined",
        "solution_research",
        "comparison",
        "purchase_ready"
      ]
    },
    "negativeSignals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subjectKind": { "const": "individual" },
    "version": { "type": "integer", "minimum": 1 },
    "identityResolved": { "type": "boolean" },
    "status": {
      "enum": [
        "discovered",
        "unresolvable",
        "normalized",
        "qualified",
        "pending_review",
        "approved",
        "rejected",
        "do_not_contact",
        "needs_research",
        "converted_to_lead"
      ]
    },
    "latestDecisionVersion": { "type": ["string", "null"] },
    "approvedDecisionVersion": { "type": ["string", "null"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "lastSeenAt": { "type": "string", "format": "date-time" }
  }
}
