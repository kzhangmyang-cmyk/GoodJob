{
  "name": "goodjob-crm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc -b && vite build",
    "test": "tsx src/self-test.ts",
    "test:e2e": "playwright test",
    "contract:import": "node scripts/import-growth-contract.mjs",
    "contract:generate": "node scripts/generate-growth-contract-types.mjs",
    "contract:check": "node scripts/check-growth-contract.mjs && node scripts/generate-growth-contract-types.mjs --check",
    "test:growth:fixture": "tsx --test tests/fixtures/growth-contract.self-test.ts",
    "test:e2e:growth": "playwright test growth-bootstrap.spec.ts",
    "test:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "echarts": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "2.8.1"
  }
}
