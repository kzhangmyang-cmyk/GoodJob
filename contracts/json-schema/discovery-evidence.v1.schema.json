{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/discovery-evidence.v1.schema.json",
  "title": "DiscoveryEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "targetType",
    "sourcePlatform",
    "sourceTitle",
    "sourceSnippet",
    "publishedAt",
    "fetchedAt",
    "locale",
    "rawArtifactHash",
    "contentHash",
    "provenance",
    "accessStatus"
  ],
  "properties": {
    "id": { "type": "string" },
    "targetType": { "enum": ["organization", "individual_signal"] },
    "sourcePlatform": { "type": "string", "minLength": 1 },
    "sourceTitle": { "type": "string" },
    "sourceSnippet": { "type": "string" },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "locale": { "type": "string", "minLength": 1 },
    "rawArtifactHash": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "minLength": 1 },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "provider",
            "queryText",
            "sourceUrl",
            "resultRank"
          ],
          "properties": {
            "kind": { "const": "search_result" },
            "provider": { "type": "string", "minLength": 1 },
            "providerConnectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "providerRecordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "queryText": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string", "format": "uri" },
            "resultRank": { "type": ["integer", "null"], "minimum": 1 },
            "sourceType": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceUrl", "submittedBy"],
          "properties": {
            "kind": { "const": "user_submitted_url" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "submittedBy": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "importBatchId",
            "artifactHash",
            "sheetName",
            "rowNumber"
          ],
          "properties": {
            "kind": { "const": "import_artifact_row" },
            "importBatchId": { "type": "string", "minLength": 1 },
            "artifactHash": { "type": "string", "minLength": 1 },
            "sheetName": { "type": "string", "minLength": 1 },
            "rowNumber": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "accessStatus": {
      "enum": [
        "indexed_summary",
        "public_content",
        "user_supplied",
        "access_restricted"
      ]
    }
  }
}
