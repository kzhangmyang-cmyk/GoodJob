{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/douyin-visual-comment-observation.v1.schema.json",
  "title": "DouyinVisualCommentObservationV1",
  "description": "Server-normalized observation of one currently visible top-level Douyin comment. Standard JSON Schema validates sourceUrl and videoId independently; the Task 3 service must require the numeric sourceUrl video segment to equal videoId before persistence.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableVisibleString": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S" },
        { "type": "null" }
      ]
    },
    "nullableCount": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        { "type": "null" }
      ]
    },
    "nullablePlatformCommentId": {
      "oneOf": [
        { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
        { "type": "null" }
      ]
    },
    "nullablePublicProfileUrl": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 170,
          "pattern": "^https://www\\.douyin\\.com/user/[A-Za-z0-9._~-]{1,128}/?$"
        },
        { "type": "null" }
      ]
    },
    "nullableSecUid": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
        { "type": "null" }
      ]
    },
    "fieldConfidences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibleText"],
      "properties": {
        "visibleText": { "type": "number", "minimum": 0, "maximum": 1 },
        "displayName": { "type": "number", "minimum": 0, "maximum": 1 },
        "visibleTimeText": { "type": "number", "minimum": 0, "maximum": 1 },
        "likeCount": { "type": "number", "minimum": 0, "maximum": 1 },
        "replyCount": { "type": "number", "minimum": 0, "maximum": 1 },
        "platformCommentId": { "type": "number", "minimum": 0, "maximum": 1 },
        "publicProfileUrl": { "type": "number", "minimum": 0, "maximum": 1 },
        "secUid": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cardBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 8192 },
        "y": { "type": "number", "minimum": 0, "maximum": 8192 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observationId",
    "sessionId",
    "sourceUrl",
    "videoId",
    "visibleText",
    "textHash",
    "displayName",
    "visibleTimeText",
    "likeCount",
    "replyCount",
    "platformCommentId",
    "publicProfileUrl",
    "secUid",
    "extractionMethod",
    "fieldConfidences",
    "viewportHash",
    "cardBounds",
    "redactedCropHash",
    "readerVersion",
    "capturedAt"
  ],
  "properties": {
    "observationId": { "$ref": "#/$defs/identifier" },
    "sessionId": { "$ref": "#/$defs/identifier" },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 80,
      "pattern": "^https://www\\.douyin\\.com/video/[1-9][0-9]{0,31}/?$"
    },
    "videoId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "visibleText": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "textHash": { "$ref": "#/$defs/digest" },
    "displayName": { "$ref": "#/$defs/nullableVisibleString" },
    "visibleTimeText": { "$ref": "#/$defs/nullableVisibleString" },
    "likeCount": { "$ref": "#/$defs/nullableCount" },
    "replyCount": { "$ref": "#/$defs/nullableCount" },
    "platformCommentId": { "$ref": "#/$defs/nullablePlatformCommentId" },
    "publicProfileUrl": {
      "$ref": "#/$defs/nullablePublicProfileUrl",
      "description": "Literal public profile link fact only. Standard JSON Schema validates it independently; the Task 3 service must verify its public user key agrees with secUid before persistence."
    },
    "secUid": { "$ref": "#/$defs/nullableSecUid" },
    "extractionMethod": {
      "type": "string",
      "enum": ["dom", "accessibility", "ocr", "vision"]
    },
    "fieldConfidences": { "$ref": "#/$defs/fieldConfidences" },
    "viewportHash": { "$ref": "#/$defs/digest" },
    "cardBounds": { "$ref": "#/$defs/cardBounds" },
    "redactedCropHash": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "readerVersion": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
    "capturedAt": { "type": "string", "format": "date-time" }
  }
}
