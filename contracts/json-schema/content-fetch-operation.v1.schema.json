{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/content-fetch-operation.v1.schema.json",
  "title": "ContentFetchOperation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ownerId",
    "teamId",
    "actorId",
    "sourceUrl",
    "finalUrl",
    "subjectChannel",
    "status",
    "accessStatus",
    "httpStatus",
    "contentType",
    "title",
    "rawArtifactHash",
    "contentHash",
    "evidenceCount",
    "evidenceIds",
    "candidateCount",
    "candidateIds",
    "errorCode",
    "createdAt",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "finalUrl": { "type": ["string", "null"], "format": "uri" },
    "subjectChannel": { "enum": ["organization", "individual"] },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "access_restricted"
      ]
    },
    "accessStatus": {
      "type": ["string", "null"],
      "enum": ["public_content", "access_restricted", null]
    },
    "httpStatus": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "contentType": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "rawArtifactHash": { "type": ["string", "null"] },
    "contentHash": { "type": ["string", "null"] },
    "evidenceCount": { "type": "integer", "minimum": 0 },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "candidateCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "candidateIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "maxItems": 1
    },
    "errorCode": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "enum": ["succeeded", "access_restricted"] },
        "evidenceCount": { "type": "integer", "const": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    {
      "properties": {
        "status": { "enum": ["queued", "running"] },
        "evidenceCount": { "type": "integer", "const": 0 },
        "evidenceIds": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "properties": {
        "status": { "const": "failed" },
        "evidenceCount": { "type": "integer", "const": 0 },
        "evidenceIds": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "properties": {
        "status": { "const": "failed" },
        "evidenceCount": { "type": "integer", "const": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "enum": ["queued", "running"] }
        }
      },
      "then": {
        "properties": {
          "candidateCount": { "type": "integer", "const": 0 },
          "candidateIds": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "required": ["evidenceCount"],
        "properties": {
          "evidenceCount": { "const": 0 }
        }
      },
      "then": {
        "properties": {
          "candidateCount": { "type": "integer", "const": 0 },
          "candidateIds": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "oneOf": [
        {
          "required": ["candidateCount", "candidateIds"],
          "properties": {
            "candidateCount": { "type": "integer", "const": 0 },
            "candidateIds": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "required": ["candidateCount", "candidateIds"],
          "properties": {
            "candidateCount": { "type": "integer", "const": 1 },
            "candidateIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        {
          "not": {
            "anyOf": [
              { "required": ["candidateCount"] },
              { "required": ["candidateIds"] }
            ]
          }
        }
      ]
    }
  ]
}
