{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/acquisition-visual-reader-session.v1.schema.json",
  "title": "VisualReaderSession",
  "description": "Server-owned public projection for one explicitly authorized, bounded, read-only visual reader session.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "stableErrorCode": {
      "type": "string",
      "enum": [
        "visual_reader_not_enabled",
        "visual_reader_session_expired",
        "visual_reader_budget_exhausted",
        "visual_source_invalid",
        "visual_observation_invalid",
        "visual_artifact_invalid",
        "visual_extraction_method_disabled",
        "visual_extraction_low_confidence",
        "visual_reader_user_takeover"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxVideos",
        "maxCommentsPerVideo",
        "maxScrolls",
        "maxOcrCalls",
        "maxDurationMs"
      ],
      "properties": {
        "maxVideos": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxCommentsPerVideo": { "type": "integer", "minimum": 1, "maximum": 30 },
        "maxScrolls": { "type": "integer", "minimum": 0, "maximum": 5 },
        "maxOcrCalls": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videoCount",
        "observationCount",
        "scrollCount",
        "ocrCallCount",
        "domObservationCount",
        "accessibilityObservationCount",
        "ocrObservationCount",
        "lowConfidenceObservationCount",
        "artifactCount"
      ],
      "properties": {
        "videoCount": { "type": "integer", "minimum": 0, "maximum": 10 },
        "observationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "scrollCount": { "type": "integer", "minimum": 0, "maximum": 5 },
        "ocrCallCount": { "type": "integer", "minimum": 0, "maximum": 10 },
        "domObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "accessibilityObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "ocrObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "lowConfidenceObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "artifactCount": { "type": "integer", "minimum": 0, "maximum": 300 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "videoCount",
        "observationCount",
        "domObservationCount",
        "accessibilityObservationCount",
        "ocrObservationCount",
        "lowConfidenceObservationCount",
        "artifactCount",
        "errorCodes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "partial_success", "aborted", "expired"]
        },
        "videoCount": { "type": "integer", "minimum": 0, "maximum": 10 },
        "observationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "domObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "accessibilityObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "ocrObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "lowConfidenceObservationCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "artifactCount": { "type": "integer", "minimum": 0, "maximum": 300 },
        "errorCodes": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableErrorCode" }
        }
      }
    },
    "pixelRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "y": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "opaqueRectRedactionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maskColorRgba",
        "avatarBounds",
        "visibleRegions",
        "maskedRegions"
      ],
      "properties": {
        "version": { "const": "opaque-rect-v1" },
        "maskColorRgba": {
          "type": "array",
          "const": [17, 61, 51, 255]
        },
        "avatarBounds": {
          "oneOf": [
            { "$ref": "#/$defs/pixelRect" },
            { "type": "null" }
          ]
        },
        "visibleRegions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/pixelRect" }
        },
        "maskedRegions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/pixelRect" }
        }
      }
    },
    "boundedWebpBase64": {
      "description": "Canonical base64 whose decoded length is at most 262144 bytes. Actual WebP decoding and pixel proof validation are Task 3 service responsibilities.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 4,
          "maxLength": 349524,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        {
          "type": "string",
          "minLength": 349528,
          "maxLength": 349528,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{2}==$"
        }
      ]
    },
    "visualObservationSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientObservationKey",
        "sourceUrl",
        "videoId",
        "visibleText",
        "displayName",
        "visibleTimeText",
        "likeCount",
        "replyCount",
        "platformCommentId",
        "publicProfileUrl",
        "secUid",
        "extractionMethod",
        "fieldConfidences",
        "viewport",
        "cardBounds",
        "readerVersion",
        "capturedAt",
        "redactedCrop"
      ],
      "properties": {
        "clientObservationKey": { "$ref": "#/$defs/identifier" },
        "sourceUrl": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/sourceUrl"
        },
        "videoId": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/videoId"
        },
        "visibleText": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/visibleText"
        },
        "displayName": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/displayName"
        },
        "visibleTimeText": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/visibleTimeText"
        },
        "likeCount": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/likeCount"
        },
        "replyCount": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/replyCount"
        },
        "platformCommentId": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/platformCommentId"
        },
        "publicProfileUrl": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/publicProfileUrl"
        },
        "secUid": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/secUid"
        },
        "extractionMethod": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/extractionMethod"
        },
        "fieldConfidences": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/fieldConfidences"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "deviceScaleFactor"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "deviceScaleFactor": { "type": "number", "minimum": 0.5, "maximum": 8 }
          }
        },
        "cardBounds": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/cardBounds"
        },
        "readerVersion": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/readerVersion"
        },
        "capturedAt": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json#/properties/capturedAt"
        },
        "redactedCrop": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mediaType", "contentBase64", "redactionProof"],
              "properties": {
                "mediaType": { "const": "image/webp" },
                "contentBase64": { "$ref": "#/$defs/boundedWebpBase64" },
                "redactionProof": { "$ref": "#/$defs/opaqueRectRedactionProof" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "artifactUploadEnabled"],
      "properties": {
        "runId": { "$ref": "#/$defs/identifier" },
        "artifactUploadEnabled": { "type": "boolean" }
      }
    },
    "visualObservationBatchRequest": {
      "description": "At most 20 client observations, with no more than five redacted crops.",
      "type": "object",
      "additionalProperties": false,
      "required": ["observations"],
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/visualObservationSubmission" },
          "contains": {
            "type": "object",
            "required": ["redactedCrop"],
            "properties": { "redactedCrop": { "type": "object" } }
          },
          "minContains": 0,
          "maxContains": 5
        }
      }
    },
    "acceptedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientObservationKey", "observation"],
      "properties": {
        "clientObservationKey": { "$ref": "#/$defs/identifier" },
        "observation": {
          "$ref": "douyin-visual-comment-observation.v1.schema.json"
        }
      }
    },
    "visualObservationBatchResponse": {
      "description": "Accepted observations are server-normalized facts. Standard JSON Schema validates each sessionId independently; the Task 3 service must require the route, session, and every observation sessionId to agree before returning the response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "accepted", "duplicates"],
      "properties": {
        "session": { "$ref": "#" },
        "accepted": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/acceptedObservation" }
        },
        "duplicates": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "completeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errorCodes"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "partial_success"] },
        "errorCodes": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableErrorCode" }
        }
      }
    },
    "abortRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode"],
      "properties": {
        "reasonCode": {
          "type": "string",
          "enum": ["user_requested", "visual_reader_user_takeover"]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "runId",
    "planId",
    "planVersionId",
    "platform",
    "coverage",
    "status",
    "artifactUploadEnabled",
    "limits",
    "usage",
    "outcome",
    "lastErrorCode",
    "createdAt",
    "authorizedAt",
    "updatedAt",
    "expiresAt",
    "completedAt"
  ],
  "properties": {
    "sessionId": { "$ref": "#/$defs/identifier" },
    "runId": { "$ref": "#/$defs/identifier" },
    "planId": { "$ref": "#/$defs/identifier" },
    "planVersionId": { "$ref": "#/$defs/identifier" },
    "platform": { "const": "douyin" },
    "coverage": { "const": "authorized_visible_top_level_sample" },
    "status": {
      "type": "string",
      "enum": ["created", "collecting", "completed", "partial_success", "aborted", "expired"]
    },
    "artifactUploadEnabled": { "type": "boolean" },
    "limits": { "$ref": "#/$defs/limits" },
    "usage": { "$ref": "#/$defs/usage" },
    "outcome": {
      "oneOf": [
        { "$ref": "#/$defs/outcome" },
        { "type": "null" }
      ]
    },
    "lastErrorCode": {
      "oneOf": [
        { "$ref": "#/$defs/stableErrorCode" },
        { "type": "null" }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "authorizedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "completedAt": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": { "enum": ["created", "collecting"] },
        "outcome": { "type": "null" },
        "completedAt": { "type": "null" }
      }
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "completed" },
        "outcome": {
          "allOf": [
            { "$ref": "#/$defs/outcome" },
            { "type": "object", "properties": { "status": { "const": "completed" } } }
          ]
        },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "partial_success" },
        "outcome": {
          "allOf": [
            { "$ref": "#/$defs/outcome" },
            { "type": "object", "properties": { "status": { "const": "partial_success" } } }
          ]
        },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "aborted" },
        "outcome": {
          "allOf": [
            { "$ref": "#/$defs/outcome" },
            { "type": "object", "properties": { "status": { "const": "aborted" } } }
          ]
        },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "properties": {
        "status": { "const": "expired" },
        "outcome": {
          "allOf": [
            { "$ref": "#/$defs/outcome" },
            { "type": "object", "properties": { "status": { "const": "expired" } } }
          ]
        },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
